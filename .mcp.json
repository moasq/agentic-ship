{
  "mcpServers": {
    "shadcn": {
      "command": "npx",
      "args": ["-y", "shadcn@4.19.1", "mcp"]
    },
    "next-devtools": {
      "command": "npx",
      "args": ["-y", "next-devtools-mcp@0.4.0"]
    },
    "magicui": {
      "command": "npx",
      "args": ["-y", "@magicuidesign/mcp@2.0.0"]
    },
    "21st": {
      "type": "http",
      "url": "https://21st.dev/api/mcp"
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@4.0.4"]
    },
    "convex": {
      "command": "npx",
      "args": ["-y", "convex@1.45.0", "mcp", "start"]
    },
    "stripe": {
      "type": "http",
      "url": "https://mcp.stripe.com"
    },
    "resend": {
      "type": "http",
      "url": "https://mcp.resend.com/mcp"
    },
    "posthog": {
      "type": "http",
      "url": "https://mcp.posthog.com/mcp"
    },
    "linear": {
      "type": "http",
      "url": "https://mcp.linear.app/mcp"
    },
    "playwright-test": {
      "command": "npx",
      "args": ["-y", "playwright@1.62.1", "run-test-mcp-server"]
    },
    "agentic-ship": {
      "command": "node",
      "args": ["scripts/mcp-server.mjs", "--allow-mutations"]
    }
  }
}
