# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# but ship the template
!.env.example

# Fontshare faces are licensed but NOT redistributable - each machine runs `pnpm font`.
# OFL faces ARE redistributable and are committed on purpose: a build that fetches
# fonts is a build that dies on a host with no egress. See .agents/heal-ledger.md.
# Note the trailing /* — git cannot re-include a file whose parent dir is excluded.
src/fonts/*
!src/fonts/ofl/

# playwright
/test-results/
/playwright-report/

# Local, non-secret receipts for resumable agent-to-service connection handoffs.
# The connection CLI writes only provider/host/state/timestamps here; never tokens.
/.agent-state/

# Local Netlify folder
.netlify
