{
  "$comment": "Machine config only — permissions and plugin wiring. All instructions live in AGENTS.md; all procedures live in .agents/skills/. Never duplicate rules here.",
  "extraKnownMarketplaces": {
    "nextjs": {
      "source": {
        "source": "github",
        "repo": "vercel/next.js"
      }
    }
  },
  "enabledPlugins": {
    "nextjs@nextjs": true,
    "convex@claude-plugins-official": true,
    "stripe@claude-plugins-official": true,
    "resend@claude-plugins-official": true,
    "posthog@claude-plugins-official": true,
    "render@claude-plugins-official": true
  },
  "$comment:hooks": "Claude-only teeth for the AGENTS.md rule 'nothing is done until the build is green'. Codex/Cursor cannot run hooks, so for them AGENTS.md is the rule and CI is the backstop. --hook exits 2 (blocks the stop) and honors stop_hook_active so a failure it cannot fix never traps you.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/verify.mjs --quiet --hook"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm dev)",
      "Bash(pnpm build)",
      "Bash(pnpm lint)",
      "Bash(pnpm audit:*)",
      "Bash(pnpm health)",
      "Bash(pnpm setup:env)",
      "Bash(pnpm link:skills)",
      "Bash(pnpm sync:mcp)",
      "Bash(pnpm check:mcp)",
      "Bash(pnpm onboard)",
      "Bash(pnpm asset:*)",
      "Bash(pnpm font:*)",
      "Bash(npx shadcn@latest add:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)"
    ]
  }
}
