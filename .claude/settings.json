{
  "$comment": "Machine config only — permissions and plugin wiring. All instructions live in AGENTS.md; all procedures live in .agents/skills/. Never duplicate rules here.",
  "extraKnownMarketplaces": {
    "nextjs": {
      "source": {
        "source": "github",
        "repo": "vercel/next.js"
      }
    }
  },
  "enabledPlugins": {
    "nextjs@nextjs": true,
    "convex@claude-plugins-official": true,
    "stripe@claude-plugins-official": true,
    "resend@claude-plugins-official": true,
    "posthog@claude-plugins-official": true,
    "render@claude-plugins-official": true
  },
  "$comment:hooks": "Claude's native adapter for the cross-host definition-of-done rule. Codex and Cursor have generated native hooks; Hermes follows AGENTS.md with CI as backstop. --hook exits 2 and honors stop_hook_active so a failure cannot trap the user.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/verify.mjs --quiet --hook"
          }
        ]
      }
    ]
  },
  "$comment:permissions": "Every read-only or repo-local Agentic Ship command is allowed, so the verify/heal loop runs without a prompt on a headless clone. Anything that spends money, touches a deployment, or rewrites history is deliberately absent — that is a human decision, not friction to remove.",
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm dev)",
      "Bash(pnpm build)",
      "Bash(pnpm lint)",
      "Bash(pnpm audit:*)",
      "Bash(pnpm health)",
      "Bash(pnpm verify)",
      "Bash(pnpm verify:full)",
      "Bash(pnpm heal)",
      "Bash(pnpm preflight)",
      "Bash(pnpm test)",
      "Bash(pnpm test:e2e)",
      "Bash(pnpm secret)",
      "Bash(pnpm setup:env)",
      "Bash(pnpm link:skills)",
      "Bash(pnpm sync:mcp)",
      "Bash(pnpm check:mcp)",
      "Bash(pnpm sync:agents)",
      "Bash(pnpm check:agents)",
      "Bash(pnpm check:ui)",
      "Bash(pnpm agent:work:*)",
      "Bash(pnpm connect:*)",
      "Bash(pnpm component:place:*)",
      "Bash(pnpm onboard)",
      "Bash(pnpm asset:*)",
      "Bash(pnpm font:*)",
      "Bash(npx shadcn@4.16.1 add:*)",
      "Bash(npx playwright install:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)"
    ]
  }
}
