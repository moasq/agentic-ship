{
  "shadcn": {
    "command": "npx",
    "args": [
      "-y",
      "shadcn@4.19.1",
      "mcp"
    ]
  },
  "next-devtools": {
    "command": "npx",
    "args": [
      "-y",
      "next-devtools-mcp@0.4.0"
    ]
  },
  "magicui": {
    "command": "npx",
    "args": [
      "-y",
      "@magicuidesign/mcp@2.0.0"
    ]
  },
  "21st": {
    "url": "https://21st.dev/api/mcp"
  },
  "context7": {
    "command": "npx",
    "args": [
      "-y",
      "@upstash/context7-mcp@4.0.4"
    ]
  },
  "convex": {
    "command": "npx",
    "args": [
      "-y",
      "convex@1.45.0",
      "mcp",
      "start"
    ]
  },
  "stripe": {
    "url": "https://mcp.stripe.com"
  },
  "resend": {
    "url": "https://mcp.resend.com/mcp"
  },
  "posthog": {
    "url": "https://mcp.posthog.com/mcp"
  },
  "linear": {
    "url": "https://mcp.linear.app/mcp"
  },
  "playwright-test": {
    "command": "npx",
    "args": [
      "-y",
      "playwright@1.62.1",
      "run-test-mcp-server"
    ]
  },
  "agentic-ship": {
    "command": "node",
    "args": [
      "scripts/mcp-server.mjs",
      "--allow-mutations"
    ]
  }
