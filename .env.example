# Copy to .env.local and fill in. Never commit .env.local.
# Names only in this file — no values, ever.

# Public: shipped to the browser by design. Used for canonical URLs, sitemap, OG.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Convex. All three are written for you by `npx convex dev` — do not fill them in by
# hand. Run `pnpm onboard` to see where you are in the sequence.
# The two NEXT_PUBLIC_ values are URLs and public by design; CONVEX_DEPLOYMENT is a
# local pointer, not a credential. Real backend secrets NEVER live in this file —
# they go in Convex env: `pnpm secret`, then `npx convex env set <NAME> <value>`.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Analytics. The phc_ PROJECT key is public by design — it is meant to ship to the
# browser. Events are proxied through /ingest on this origin, so no PostHog host is
# ever added to the CSP. A phx_ PERSONAL key is a full-access credential and must never
# appear here or anywhere else in the repo.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# There are deliberately NO auth, Stripe or Resend secrets here. BETTER_AUTH_SECRET,
# SITE_URL, STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, STRIPE_PRICE_*, RESEND_API_KEY,
# RESEND_WEBHOOK_SECRET, EMAIL_FROM and CONVEX_DEPLOY_KEY all live in Convex env (or,
# for the deploy key, in Render) — `pnpm health` fails CRITICAL if any appears here.

# Optional. Only needed if you enable the 21st MCP server in .mcp.json.
# Get a key at https://21st.dev/mcp — the bundle works without it, the fallback
# is browsing 21st.dev and pasting the component prompt.
TWENTYFIRST_API_KEY=
