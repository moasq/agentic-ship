# Copy to .env.local (`pnpm setup:env` does this for you). Never commit .env.local.
# Names only in this file — no values, ever.
#
# This is the tool-only engine: it bundles no web application, so the only variables
# listed here are the ones this repo's own scripts read. A downstream product workspace
# that adopts Agentic Ship adds its own product variables to its own .env.example.
#
# Real secrets NEVER live in this file or in .env.local. Auth, Stripe, Resend and every
# other credential live in Convex env — set them with `pnpm secret:set <NAME>` (hidden
# input, piped straight into Convex env). `pnpm health` flags any secret that leaks here.

# Convex. Written for you by `npx convex dev` — do not fill these in by hand.
# Both are URLs and public by design (the only Convex values the browser ever sees);
# `pnpm stripe:provision` reads NEXT_PUBLIC_CONVEX_SITE_URL to register the webhook.
# Run `pnpm onboard` to see where you are in the connection sequence.
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Optional. Selects which paired Stripe CLI profile `pnpm stripe:provision` reads
# (defaults to "default"). Not a secret — just a profile name.
STRIPE_PROFILE=

# Optional. Only if you enable the 21st.dev MCP server in .mcp.json. The bundle works
# without it; `pnpm provider:login 21st` pairs the CLI through its own browser OAuth
# instead, so no key need ever be pasted here.
TWENTYFIRST_API_KEY=
