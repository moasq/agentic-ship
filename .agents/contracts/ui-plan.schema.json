{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-workspace.dev/contracts/ui-plan.schema.json",
  "title": "UI visual direction plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "product",
    "actors",
    "journey",
    "contentHierarchy",
    "directionExploration",
    "visualThesis",
    "signatureElement",
    "surfaces",
    "viewports",
    "references",
    "tokens",
    "motionBudget",
    "componentSources",
    "responsiveIntent",
    "accessibilityConstraints",
    "antiGoals",
    "dataPolicy"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "audience"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "audience": { "type": "string", "minLength": 1 }
      }
    },
    "actors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "journey": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "contentHierarchy": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "directionExploration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidates", "selectedDirection", "refinementVariants", "selectedVariant"],
      "properties": {
        "candidates": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/directionCandidate" }
        },
        "selectedDirection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "rationale", "rejections"],
          "properties": {
            "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
            "rationale": { "type": "string", "minLength": 1 },
            "rejections": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "reason"],
                "properties": {
                  "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
                  "reason": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        },
        "refinementVariants": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/refinementVariant" }
        },
        "selectedVariant": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "rationale"],
          "properties": {
            "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
            "rationale": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "visualThesis": { "type": "string", "minLength": 1 },
    "signatureElement": { "type": "string", "minLength": 1 },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/surface" }
    },
    "viewports": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/viewport" },
      "allOf": [
        { "contains": { "type": "object", "required": ["width"], "properties": { "width": { "const": 320 } } } },
        { "contains": { "type": "object", "required": ["width"], "properties": { "width": { "const": 768 } } } },
        { "contains": { "type": "object", "required": ["width"], "properties": { "width": { "const": 1440 } } } }
      ]
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/reference" }
    },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["typography", "palette", "density", "shapeLanguage"],
      "properties": {
        "typography": { "type": "string", "minLength": 1 },
        "palette": { "type": "string", "minLength": 1 },
        "density": { "type": "string", "minLength": 1 },
        "shapeLanguage": { "type": "string", "minLength": 1 }
      }
    },
    "motionBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxSimultaneousPieces", "purpose"],
      "properties": {
        "maxSimultaneousPieces": { "type": "integer", "minimum": 0, "maximum": 2 },
        "purpose": { "type": "string", "minLength": 1 }
      }
    },
    "componentSources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["need", "source", "decision"],
        "properties": {
          "need": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 },
          "decision": { "type": "string", "minLength": 1 }
        }
      }
    },
    "responsiveIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["narrow", "tablet", "desktop"],
      "properties": {
        "narrow": { "type": "string", "minLength": 1 },
        "tablet": { "type": "string", "minLength": 1 },
        "desktop": { "type": "string", "minLength": 1 }
      }
    },
    "accessibilityConstraints": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "antiGoals": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "dataPolicy": { "const": "public-or-synthetic-only" }
  },
  "$defs": {
    "directionCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "thesis", "composition", "typography", "palette", "signatureElement"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "thesis": { "type": "string", "minLength": 1 },
        "composition": { "type": "string", "minLength": 1 },
        "typography": { "type": "string", "minLength": 1 },
        "palette": { "type": "string", "minLength": 1 },
        "signatureElement": { "type": "string", "minLength": 1 }
      }
    },
    "refinementVariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "change", "tradeoff"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "change": { "type": "string", "minLength": 1 },
        "tradeoff": { "type": "string", "minLength": 1 }
      }
    },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "width", "height"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "width": { "type": "integer", "minimum": 320, "maximum": 3840 },
        "height": { "type": "integer", "minimum": 480, "maximum": 2160 }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "url", "provenance", "lesson"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "provenance": {
          "enum": ["live-site", "video", "primary-documentation", "product-research", "existing-ui"]
        },
        "lesson": { "type": "string", "minLength": 1 }
      }
    },
    "marker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "name"],
      "properties": {
        "role": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "query", "marker"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "description": { "type": "string", "minLength": 1 },
        "query": { "type": "string" },
        "marker": { "$ref": "#/$defs/marker" }
      }
    },
    "interaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "name", "purpose"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "role": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1 }
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "route", "owner", "states", "themes", "interactions"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "route": { "type": "string", "pattern": "^/(?!/)[^?#\\\\]*$" },
        "owner": { "enum": ["frontend-builder", "quality-engineer"] },
        "states": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/state" }
        },
        "themes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "enum": ["light", "dark"] }
        },
        "interactions": {
          "type": "array",
          "items": { "$ref": "#/$defs/interaction" }
        }
      }
    }
  }
}
